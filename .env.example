# Application
APP_NAME="Keyloop Sales Lead Management API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database (SQLite default for local dev; switch to PostgreSQL 16 for production/Docker)
DATABASE_URL="sqlite:///./keyloop_leads.db"
# DATABASE_URL="postgresql+psycopg://keyloop:keyloop@localhost:5432/keyloop_leads"

# PostgreSQL Pool Settings (applied only when using PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Default Dealership Tenant UUID for MVP zero-config evaluation
DEFAULT_DEALERSHIP_ID="11111111-1111-4111-8111-111111111111"
